# Job worker (apps/job-worker). Runs BullMQ jobs that hold no signing key:
# host-side delivery verification (JSON and file results) and upload cleanup.
# Exposes no HTTP port.

# Required. Same database as the API. SECRET.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payvoke
# Required. Same Redis as the API and workers. SECRET if it embeds a password.
REDIS_URL=redis://127.0.0.1:6380

# --- Files (S3-compatible storage) ---
# Must match the API. With files disabled, file results are never verified and
# are refunded at the delivery deadline. See apps/api/.env.example for details.
FILES_ENABLED=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# SECRET.
S3_ACCESS_KEY_ID=
# SECRET.
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
