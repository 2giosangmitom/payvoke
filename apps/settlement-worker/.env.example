# Settlement worker (apps/settlement-worker). Signs and sends reserveHold.
# The only process that holds RELAYER_PRIVATE_KEY. Exposes no HTTP port.

# Required true to start; false exits immediately.
EXECUTION_ENABLED=false
# Required. Same database as the API. SECRET.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payvoke

# --- Vault deployment (must match apps/facilitator) ---
# Required. Must equal the API's API_ORIGIN.
API_ORIGIN=http://localhost:3001
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VAULT_ADDRESS=0xa546D44E1FD0706A407BD41b509c91D4F2b52E7E
EXPECTED_VAULT_CODE_HASH=0x80892ca0f2926335926fcfe549b16347c50a105700b2ac31e5dcfd98b1e2114d
VAULT_FEE_CAP_BPS=1000
VAULT_MAX_QUOTE_LIFETIME_SECONDS=600
VAULT_MAX_HOLD_SECONDS=604800
# First block scanned for finalized holds (the vault deployment block).
DEPLOYMENT_START_BLOCK=59996514

# --- Relayer wallet (holds RELAYER_ROLE; fund with Fuji AVAX) ---
# Required. Address derived from RELAYER_PRIVATE_KEY; also set in apps/facilitator.
RELAYER_ADDRESS=
# Required. Dedicated key used by no other wallet or script. SECRET.
RELAYER_PRIVATE_KEY=

# --- Gas budget. Integer strings in wei, NOT AVAX. No defaults are inferred. ---
GAS_MAX_LIMIT=
GAS_MAX_FEE_PER_GAS=
GAS_MAX_PRIORITY_FEE_PER_GAS=
GAS_MAX_TRANSACTION_COST=
GAS_MAX_OUTSTANDING_COST=
# Rolling window for GAS_MAX_WINDOW_COST, in seconds.
GAS_WINDOW_SECONDS=
GAS_MAX_WINDOW_COST=
