# Finance worker (apps/finance-worker). Automatically refunds undelivered, failed
# or late invocations and releases verified deliveries after the review window.
# Holds the approver and executor keys; exposes no HTTP port.

# Required true to start; false exits immediately.
EXECUTION_ENABLED=false
# Required. Same database as the API. SECRET.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payvoke

# --- Vault deployment (must match apps/facilitator and apps/settlement-worker) ---
API_ORIGIN=http://localhost:3001
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VAULT_ADDRESS=
EXPECTED_VAULT_CODE_HASH=
VAULT_FEE_CAP_BPS=1000
VAULT_MAX_QUOTE_LIFETIME_SECONDS=600
VAULT_MAX_HOLD_SECONDS=604800
# Public address of the settlement relayer; the executor must be a different wallet.
RELAYER_ADDRESS=

# --- Finance wallets (two distinct keys, neither the relayer) ---
# Holds REFUND_APPROVER_ROLE + RELEASE_APPROVER_ROLE; signs decisions only, needs no AVAX. SECRET.
FINANCE_APPROVER_PRIVATE_KEY=
# Holds FINANCE_EXECUTOR_ROLE and sends applyDecision; fund with Fuji AVAX. SECRET.
FINANCE_EXECUTOR_PRIVATE_KEY=

# --- Gas budget. Integer strings in wei, NOT AVAX. No defaults are inferred. ---
GAS_MAX_LIMIT=
GAS_MAX_FEE_PER_GAS=
GAS_MAX_PRIORITY_FEE_PER_GAS=
GAS_MAX_TRANSACTION_COST=
GAS_MAX_OUTSTANDING_COST=
# Rolling window for GAS_MAX_WINDOW_COST, in seconds.
GAS_WINDOW_SECONDS=
GAS_MAX_WINDOW_COST=
