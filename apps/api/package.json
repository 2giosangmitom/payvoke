{
  "name": "api",
  "private": true,
  "type": "module",
  "imports": {
    "#core/db": "./src/core/db/index.ts",
    "#core/facilitator": "./src/core/facilitator/index.ts",
    "#core/payments/*": "./src/core/payments/*.ts",
    "#core/queue": "./src/core/queue/index.ts",
    "#core/runtime": "./src/core/runtime/index.ts",
    "#core/storage": "./src/core/storage/index.ts",
    "#test/*": "./test/*.ts"
  },
  "exports": {
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "dev": "bun --watch ./src/server.ts",
    "start": "bun ./src/server.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:create": "prisma migrate dev --create-only",
    "auth:schema": "bunx auth@1.7.11 generate --config auth.cli.ts --output prisma/auth.prisma --yes",
    "test": "bun test test/",
    "test:payments:evm": "bun --cwd ../../packages/vault compile && PAYMENTS_TEST_EVM=1 bun test -t \"real local USDC|financial lifecycle\" test/e2e/quotes.test.ts",
    "test:conformance": "bun ./scripts/conformance.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@better-auth/prisma-adapter": "1.7.11",
    "@hono/zod-validator": "^0.9.1",
    "@logtape/hono": "^2.4.2",
    "@logtape/logtape": "^2.4.2",
    "@logtape/redaction": "^2.4.2",
    "@openuidev/lang-core": "^1.0.1",
    "@payvoke/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@x402/core": "2.28.0",
    "ajv": "8.20.0",
    "awilix": "13.0.5",
    "better-auth": "1.7.11",
    "bullmq": "6.3.13",
    "close-with-grace": "^2.5.0",
    "dotenv": "^18.0.9",
    "env-schema": "^8.0.1",
    "hono": "^4.13.14",
    "ioredis": "6.0.0",
    "jsonc-parser": "3.3.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "typebox": "^1.4.3",
    "viem": "2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@types/bun": "^1.4.4",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
