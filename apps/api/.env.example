# Runtime DB: local Docker for development, Neon for production only.
# Tests default to PGlite and do not use DATABASE_URL. Never commit credentials.
# Every backend process (API, facilitator, settlement worker, ops:fuji) loads
# this file through dotenv. Variables already set in the shell take precedence.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payvoke
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
HOST=127.0.0.1
# API port. The facilitator also reads PORT, so start it with PORT=3002 in front.
PORT=3001
PROCESS_ROLE=api
LOG_LEVEL=info
CHAIN_ID=43113
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# Requires FACILITATOR_URL, FACILITATOR_TOKEN and VAULT_ADDRESS, or the API refuses to start.
PAYMENTS_ENABLED=false
FACILITATOR_URL=http://127.0.0.1:3002
# Generate independently of BETTER_AUTH_SECRET: openssl rand -base64 32
FACILITATOR_TOKEN=
AGUI_CURSOR_RETENTION_SECONDS=604800

# --- Fuji deployment (packages/payvoke-vault/ignition/deployments/chain-43113) ---
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VAULT_ADDRESS=0xa546D44E1FD0706A407BD41b509c91D4F2b52E7E
EXPECTED_VAULT_CODE_HASH=0x80892ca0f2926335926fcfe549b16347c50a105700b2ac31e5dcfd98b1e2114d
DEPLOYMENT_START_BLOCK=59996514
VAULT_FEE_CAP_BPS=1000
VAULT_MAX_QUOTE_LIFETIME_SECONDS=600
VAULT_MAX_HOLD_SECONDS=604800

# --- Facilitator (pnpm dev:facilitator) ---
# Preview-only by default. True enables durable intent submission, not signing.
SETTLEMENT_ENABLED=false

# --- Settlement worker (pnpm worker:settlement), wallet holding RELAYER_ROLE ---
EXECUTION_ENABLED=false
RELAYER_ADDRESS=
RELAYER_PRIVATE_KEY=
# All gas prices/costs below are canonical integer strings in wei, NOT AVAX.
# No production economic defaults; supply an approved gas budget explicitly.
GAS_MAX_LIMIT=
GAS_MAX_FEE_PER_GAS=
GAS_MAX_PRIORITY_FEE_PER_GAS=
GAS_MAX_TRANSACTION_COST=
GAS_MAX_OUTSTANDING_COST=
GAS_WINDOW_SECONDS=
GAS_MAX_WINDOW_COST=

# --- Finance ceremony (pnpm ops:fuji) ---
# Dedicated controlled-run DB only. Never infer from production DATABASE_URL.
CEREMONY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/payvoke_fuji_test
FUJI_BROADCAST_ENABLED=false
FINANCE_EXECUTION_ENABLED=false
MANUAL_DELIVERY_ATTESTATION_ENABLED=false
# Wallet holding RELEASE/REFUND_APPROVER_ROLE (signs EIP-712 decisions).
APPROVER_PRIVATE_KEY=
# Wallet holding FINANCE_EXECUTOR_ROLE (sends applyDecision). Must differ from approver.
# ops:fuji refuses to run while both keys are set, so blank the other one per command:
#   FINANCE_EXECUTOR_PRIVATE_KEY= pnpm ops:fuji finance-approve ...
#   APPROVER_PRIVATE_KEY= pnpm ops:fuji finance-tick ...
FINANCE_EXECUTOR_PRIVATE_KEY=
# Ceremony-only signers (prepare / login / payment-prepare). Leave empty for the web demo.
OPERATOR_PRIVATE_KEY=
BUYER_PRIVATE_KEY=
GRANT_PRIVATE_KEY=
