# API (apps/api). Public HTTP service for the web app and provider integrations.
# Holds no signing key. Never copy relayer, approver or executor keys here.

# --- Runtime ---
# Required. Shared Postgres used by api, facilitator and settlement-worker. SECRET.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payvoke
# Required. Public origin of this API (cookies, SIWE URI, resource URLs).
API_ORIGIN=http://localhost:3001
# Required. Exact web app origin allowed by CORS and SIWE.
WEB_ORIGIN=http://localhost:3000
# Required. Better Auth signing secret: openssl rand -base64 32. SECRET.
BETTER_AUTH_SECRET=
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Buyer AG-UI replay window in seconds (minimum 60).
AGUI_CURSOR_RETENTION_SECONDS=604800

# --- Chain ---
CHAIN_ID=43113
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# Required for quotes. Must equal the facilitator/worker VAULT_ADDRESS.
# From the current Ignition deployment (the earlier Fuji vault predates dispute removal).
VAULT_ADDRESS=

# --- Payments ---
# true requires FACILITATOR_URL, FACILITATOR_TOKEN and VAULT_ADDRESS, or startup fails.
PAYMENTS_ENABLED=false
# Private URL of apps/facilitator. Use TLS outside loopback.
FACILITATOR_URL=http://127.0.0.1:3002
# Service token shared with apps/facilitator: openssl rand -base64 32. SECRET.
FACILITATOR_TOKEN=
