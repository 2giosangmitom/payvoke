# API (apps/api). Public HTTP service for the web app and provider integrations,
# with the x402 facilitator and the workers in the same process. The signing
# workers read their keys only when enabled; leave them disabled and the keys
# empty wherever this process should hold no key. Run exactly one replica.

# --- Runtime ---
# Required. SECRET.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payvoke
# Optional: a direct, unpooled connection for `prisma migrate`. Set it when
# DATABASE_URL goes through a pooler (PgBouncer, Neon's -pooler host): the
# migration lock is session-level and a pooler can leave it stuck.
DATABASE_DIRECT_URL=
# Optional. Postgres connections per process, shared by the API and workers.
DATABASE_POOL_MAX=5
# Required. Pub/sub wake-ups for SSE and workers, and shared rate limits; never
# a source of truth.
# SECRET if it embeds a password.
REDIS_URL=redis://127.0.0.1:6380
# Required. Public origin of this API (cookies, SIWE URI, resource URLs).
API_ORIGIN=http://localhost:3001
# Required. Exact web app origin allowed by CORS and SIWE.
WEB_ORIGIN=http://localhost:3000
# Required. Better Auth signing secret: openssl rand -base64 32. SECRET.
BETTER_AUTH_SECRET=
HOST=127.0.0.1
PORT=3001
# trace, debug, info, warning, error, fatal or silent. JSON lines on stdout.
LOG_LEVEL=info

# --- Chain and vault deployment (packages/vault/ignition/deployments/chain-43113) ---
CHAIN_ID=43113
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# Required for quotes. From the current Ignition deployment: PayvokeVault v2
# (per-job escrow) is 0xc8d77919e1D9A473eB8D45C729613943eaF6f034 on Fuji.
VAULT_ADDRESS=
# Fuji RPC with finalized block support; https outside loopback. SECRET if it embeds a key.
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Public address of the wallet holding RELAYER_ROLE.
RELAYER_ADDRESS=
# keccak256 of the deployed runtime code. v2 on Fuji:
# 0xaf6df92b68a2a7ccb878b01bf22d5219172e8df8804d8521707367ed1df0ebed
EXPECTED_VAULT_CODE_HASH=
VAULT_FEE_CAP_BPS=1000
VAULT_MAX_QUOTE_LIFETIME_SECONDS=600
VAULT_MAX_HOLD_SECONDS=604800

# --- Payments (in-process facilitator) ---
# true requires the vault deployment above and an active deployment policy
# row, or startup fails.
PAYMENTS_ENABLED=false
# false = verify/preview only. true durably journals new submissions for the
# settlement worker (journaling signs nothing).
SETTLEMENT_ENABLED=false

# --- Files (S3-compatible storage) ---
# Any S3-compatible store: RustFS from compose locally, Neon S3 storage in
# production. Only the values change; there is no vendor-specific setting.
# true requires S3_ENDPOINT, S3_REGION, S3_BUCKET and both keys, or startup fails.
FILES_ENABLED=false
# Endpoint origin the server calls. https, except on loopback.
# Local: http://127.0.0.1:9000 (inside compose: http://rustfs:9000).
S3_ENDPOINT=
# Optional. Origin used in presigned URLs, which browsers and providers call.
# Defaults to S3_ENDPOINT; set it when the server reaches storage by another name.
S3_PUBLIC_ENDPOINT=
# SigV4 signing region. Local RustFS: us-east-1.
S3_REGION=
# The bucket must already exist, with CORS allowing PUT and GET from WEB_ORIGIN.
S3_BUCKET=
# SECRET.
S3_ACCESS_KEY_ID=
# SECRET.
S3_SECRET_ACCESS_KEY=
# true for path-style URLs (endpoint/bucket/key); RustFS needs true.
S3_FORCE_PATH_STYLE=false
# Upload size limit and presigned URL lifetimes (seconds).
FILE_MAX_BYTES=26214400
FILE_UPLOAD_TTL_SECONDS=600
FILE_DOWNLOAD_TTL_SECONDS=300

# --- Presale chat ---
# Free buyer messages per chat thread between paid invocations (1-500).
PRESALE_MESSAGE_LIMIT=20

# --- Job worker (keyless): delivery verification and upload cleanup ---
JOB_WORKER_ENABLED=true

# --- Settlement worker: funds jobs and relays buyer-signed grant changes ---
SETTLEMENT_WORKER_ENABLED=false
# Address derived from it must equal RELAYER_ADDRESS. Dedicated key used by no
# other wallet or script; fund with Fuji AVAX. SECRET.
RELAYER_PRIVATE_KEY=
# First block scanned for finalized holds: the vault deployment block, or later. v2 on Fuji:
# 60684973, after the deployment smoke test (packages/vault/scripts/fuji-smoke.ts) settled.
DEPLOYMENT_START_BLOCK=
# Gas budget. Integer strings in wei, NOT AVAX. No defaults are inferred.
SETTLEMENT_GAS_MAX_LIMIT=
SETTLEMENT_GAS_MAX_FEE_PER_GAS=
SETTLEMENT_GAS_MAX_PRIORITY_FEE_PER_GAS=
SETTLEMENT_GAS_MAX_TRANSACTION_COST=
SETTLEMENT_GAS_MAX_OUTSTANDING_COST=
# Rolling window for SETTLEMENT_GAS_MAX_WINDOW_COST, in seconds.
SETTLEMENT_GAS_WINDOW_SECONDS=
SETTLEMENT_GAS_MAX_WINDOW_COST=

# --- Finance worker: automatic refunds and releases ---
FINANCE_WORKER_ENABLED=false
# Two distinct keys, neither the relayer.
# Holds REFUND_APPROVER_ROLE + RELEASE_APPROVER_ROLE; signs decisions only, needs no AVAX. SECRET.
FINANCE_APPROVER_PRIVATE_KEY=
# Holds FINANCE_EXECUTOR_ROLE and sends applyDecision; fund with Fuji AVAX. SECRET.
FINANCE_EXECUTOR_PRIVATE_KEY=
FINANCE_GAS_MAX_LIMIT=
FINANCE_GAS_MAX_FEE_PER_GAS=
FINANCE_GAS_MAX_PRIORITY_FEE_PER_GAS=
FINANCE_GAS_MAX_TRANSACTION_COST=
FINANCE_GAS_MAX_OUTSTANDING_COST=
FINANCE_GAS_WINDOW_SECONDS=
FINANCE_GAS_MAX_WINDOW_COST=

# --- Abuse controls ---
# Reverse proxies that append X-Forwarded-For (Railway, a TLS proxy): set 1.
# 0 limits by socket address, which behind a proxy puts every client in one bucket.
TRUSTED_PROXY_HOPS=0
MAX_APPS_PER_OWNER=3
APP_CREATES_PER_DAY=5
# Hourly housekeeping: archive agents offline STALE_APP_DAYS, delete accounts
# unused after UNUSED_ACCOUNT_DAYS, remove unreferenced storage objects (>1 day old).
CLEANUP_ENABLED=true
STALE_APP_DAYS=7
UNUSED_ACCOUNT_DAYS=14
