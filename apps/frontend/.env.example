# Public frontend configuration. Match the backend's API_ORIGIN.
VITE_API_ORIGIN=http://localhost:3001
# Production only. API service the web origin proxies /v1/** and /mcp to, so
# auth cookies stay first-party. Then set VITE_API_ORIGIN and the backend's
# API_ORIGIN to the web origin. Read at build time; leave unset in development.
# API_PROXY_TARGET=https://payvoke.up.railway.app
# Optional. Omit to use wagmi's default Avalanche Fuji RPC endpoint.
# VITE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
