{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2023",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "noUncheckedSideEffectImports": false,
    "paths": {
      "@/src/*": ["./src/*"]
    }
  }
}
