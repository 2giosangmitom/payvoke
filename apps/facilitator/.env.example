# Facilitator (apps/facilitator). Private x402 service called only by the API.
# Needs the public relayer address, never its private key.

# --- Runtime ---
# Required. Same database as the API. SECRET.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payvoke
# Required. Same Redis as the API; used only to wake the settlement worker.
REDIS_URL=redis://127.0.0.1:6380
# Required. Must equal the API's API_ORIGIN (resource URLs are bound to it).
API_ORIGIN=http://localhost:3001
# Keep on loopback or a private network.
HOST=127.0.0.1
PORT=3002
LOG_LEVEL=info
# Required. Must equal the API's FACILITATOR_TOKEN. SECRET.
FACILITATOR_TOKEN=
# false = verify/preview only. true durably journals new submissions (still no signing).
SETTLEMENT_ENABLED=false

# --- Vault deployment (packages/payvoke-vault/ignition/deployments/chain-43113) ---
# Required. Fuji RPC with finalized block support; https outside loopback. SECRET if it embeds a key.
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# From the current Ignition deployment (the earlier Fuji vault predates dispute removal).
VAULT_ADDRESS=
# Required. Public address of the wallet holding RELAYER_ROLE (same as settlement-worker).
RELAYER_ADDRESS=
EXPECTED_VAULT_CODE_HASH=
VAULT_FEE_CAP_BPS=1000
VAULT_MAX_QUOTE_LIFETIME_SECONDS=600
VAULT_MAX_HOLD_SECONDS=604800
