{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "ttsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch --import ttsc/register src/main.ts",
    "test": "pnpm test:clean && pnpm test:compile && vitest run",
    "test:compile": "ttsc -p tsconfig.test.json",
    "test:watch": "pnpm test:clean && pnpm test:compile && vitest",
    "test:typecheck": "ttsc --noEmit -p tsconfig.test.json",
    "swagger": "nestia swagger",
    "sdk": "nestia sdk",
    "db": "node --import ttsc/register node_modules/@mikro-orm/cli/cli.js",
    "db:migration:create": "pnpm db migration:create",
    "db:migration:up": "pnpm db migration:up",
    "db:migration:down": "pnpm db migration:down",
    "db:migration:list": "pnpm db migration:list"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestia/core": "^14.0.3",
    "@nestia/fetcher": "^14.0.3",
    "@nestia/sdk": "^14.0.3",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typia": "15.0.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@nestjs/testing": "^12.1.3",
    "@ttsc/unplugin": "0.32.0",
    "@types/node": "^24.19.2",
    "nestia": "^14.0.3",
    "ttsc": "^0.32.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "mikro-orm": {
    "preferTs": true
  }
}
