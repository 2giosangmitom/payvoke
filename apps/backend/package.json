{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch ./src/server.ts",
    "dev:facilitator": "tsx --watch ./src/facilitator-server.ts",
    "worker:settlement": "tsx ./src/settlement-worker.ts",
    "ops:fuji": "tsx ./src/operations/cli.ts",
    "auth:schema": "pnpm dlx auth@1.7.11 generate --config auth.cli.ts --output ../../packages/payvoke-db/prisma/auth.prisma --yes",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @payvoke/db generate && tsx --test test/*.test.ts",
    "test:conformance": "pnpm --filter @payvoke/db generate && tsx ./scripts/conformance.ts",
    "test:payments:postgres": "pnpm --filter @payvoke/db generate && PAYMENTS_TEST_POSTGRES=1 tsx --test test/quotes.test.ts",
    "test:payments:evm": "pnpm --dir ../../packages/payvoke-vault compile && pnpm --filter @payvoke/db generate && PAYMENTS_TEST_EVM=1 tsx --test --test-name-pattern='real local USDC|Fuji ceremony tooling|financial lifecycle' test/quotes.test.ts test/fuji-operations.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.11",
    "@fastify/bearer-auth": "10.1.4",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@openuidev/lang-core": "^1.0.1",
    "@payvoke/db": "workspace:*",
    "@payvoke/openui-components": "workspace:*",
    "@payvoke/payments": "workspace:*",
    "@payvoke/protocol": "workspace:*",
    "@payvoke/server": "workspace:*",
    "@payvoke/x402": "workspace:*",
    "@x402/core": "2.28.0",
    "ajv": "8.20.0",
    "better-auth": "1.7.11",
    "close-with-grace": "^2.5.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "typebox": "^1.4.3",
    "viem": "2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@types/bun": "^1.4.4",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
