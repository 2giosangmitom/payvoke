{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch ./src/server.ts",
    "auth:schema": "pnpm dlx auth@1.7.11 generate --config auth.cli.ts --output prisma/auth.prisma --yes",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate:create": "prisma migrate dev --create-only --config prisma7.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "prisma generate --config prisma7.config.ts && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.11",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@payvoke/protocol": "workspace:*",
    "@payvoke/x402": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/pg": "^8.23.1",
    "@x402/core": "2.28.0",
    "ajv": "8.20.0",
    "better-auth": "1.7.11",
    "close-with-grace": "^2.5.0",
    "dotenv": "^18.0.8",
    "env-schema": "^8.0.1",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "jsonc-parser": "3.3.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "typebox": "^1.4.2",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@types/bun": "^1.4.3",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
