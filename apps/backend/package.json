{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "pnpm --filter @agentne/provider-sdk build && vitest run",
    "test:typecheck": "tsc --noEmit -p tsconfig.json",
    "publishing:review": "tsx src/modules/publishing/review.ts",
    "swagger": "pnpm build && fastify generate-swagger dist/app.js > dist/swagger.json",
    "sdk": "pnpm swagger && pnpm --filter frontend generate:api",
    "db": "MIKRO_ORM_CLI_CONFIG=dist/mikro-orm.config.js node node_modules/@mikro-orm/cli/cli.js",
    "db:migration:create": "pnpm build && pnpm db migration:create",
    "db:migration:up": "pnpm build && pnpm db migration:up",
    "db:migration:down": "pnpm build && pnpm db migration:down",
    "db:migration:list": "pnpm build && pnpm db migration:list"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@ag-ui/encoder": "0.0.59",
    "@fastify/awilix": "^8.3.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/websocket": "^11.3.4",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@supabase/supabase-js": "2.118.0",
    "ajv-formats": "^3.0.1",
    "awilix": "^13.0.5",
    "better-result": "3.0.1",
    "dotenv": "^18.0.8",
    "fastify": "5.12.5",
    "fastify-plugin": "^5.1.0",
    "typebox": "^1.4.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@agentne/provider-sdk": "workspace:*",
    "@mikro-orm/cli": "7.2.5",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "fastify-cli": "^8.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
