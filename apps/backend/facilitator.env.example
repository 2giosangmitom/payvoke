# Separate from the browser API environment. No private key is required.
HOST=127.0.0.1
PORT=3002
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/payvoke
API_ORIGIN=http://localhost:3001
RPC_URL=
# Generate independently of BETTER_AUTH_SECRET: openssl rand -base64 32
FACILITATOR_TOKEN=
# Copy all deployment values from an approved Fuji deployment manifest.
VAULT_ADDRESS=
RELAYER_ADDRESS=
EXPECTED_VAULT_CODE_HASH=
VAULT_FEE_CAP_BPS=
VAULT_MAX_QUOTE_LIFETIME_SECONDS=
VAULT_MAX_HOLD_SECONDS=
