// Active marketplace model: an app is a provider-owned bot with slash commands.
// Buyer conversations live in threads; every app exposes the same chat surface.
// App status is ACTIVE | SUSPENDED | ARCHIVED. Visibility is PUBLIC | PRIVATE.
// Availability is derived from lastHeartbeatAt, never stored as a mutable field.

model App {
  id               String    @id @default(uuid())
  ownerId          String
  clientRequestId  String
  name             String
  description      String?
  visibility       String    @default("PUBLIC")
  status           String    @default("ACTIVE")
  payoutAddress    String
  defaultCommandId String?   @unique
  lastHeartbeatAt  DateTime?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apiKeys        AppApiKey[]
  commands       AppCommand[]
  defaultCommand AppCommand?  @relation("AppDefaultCommand", fields: [defaultCommandId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  threads        ChatThread[]
  stars          AppStar[]
  quotes         Quote[]

  @@unique([ownerId, clientRequestId])
  @@index([visibility, status, id])
  @@index([ownerId, createdAt])
  @@map("apps")
}

model AppApiKey {
  id         String    @id @default(uuid())
  appId      String
  prefix     String    @unique
  secretHash String    @unique
  scopes     String[]
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  app        App       @relation(fields: [appId], references: [id], onDelete: Restrict)

  @@index([appId, revokedAt])
  @@map("app_api_keys")
}

model AppCommand {
  id               String    @id @default(uuid())
  appId            String
  name             String
  description      String
  activeRevisionId String?   @unique
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  app             App                  @relation(fields: [appId], references: [id], onDelete: Cascade)
  activeRevision  AppCommandRevision?  @relation("CommandActiveRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  revisions       AppCommandRevision[] @relation("CommandRevisions")
  defaultForApps  App[]                @relation("AppDefaultCommand")

  @@unique([appId, name])
  @@index([appId, archivedAt])
  @@map("app_commands")
}

// Every edit appends a revision. Quotes pin the revision they were issued for,
// so changing a command never rewrites an existing quote or invocation.
model AppCommandRevision {
  id                  String   @id @default(uuid())
  commandId           String
  options             Json
  inputSchema         Json
  outputSchema        Json?
  positionalParameter String?
  grossAmount         Decimal  @db.Decimal(78, 0)
  terms               Json
  deliverySeconds     Int
  reviewSeconds       Int
  createdAt           DateTime @default(now())

  command   AppCommand  @relation("CommandRevisions", fields: [commandId], references: [id], onDelete: Cascade)
  activeFor AppCommand? @relation("CommandActiveRevision")
  quotes    Quote[]

  @@index([commandId, createdAt])
  @@map("app_command_revisions")
}

model ChatThread {
  id               String    @id @default(uuid())
  buyerId          String
  appId            String
  title            String?
  clientRequestId  String    @default(uuid())
  activeQuoteId    String?   @unique
  quoteLockVersion Int       @default(0)
  lastMessageAt    DateTime  @default(now())
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  app    App     @relation(fields: [appId], references: [id], onDelete: Restrict)
  quotes Quote[]

  @@unique([buyerId, clientRequestId])
  @@index([buyerId, archivedAt, updatedAt])
  @@index([appId])
  @@map("chat_threads")
}

model AppStar {
  userId    String
  appId     String
  createdAt DateTime @default(now())
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([userId, appId])
  @@index([userId, createdAt])
  @@map("app_stars")
}

model DeploymentPolicy {
  version                String @id
  // Only the current policy has activeSlot="active"; old versions are retained.
  activeSlot             String? @unique
  vault                  String
  feeBps                 Int
  feeRecipient           String
  quoteLifetimeSeconds   Int
  maxHoldSeconds         Int
  resolutionGraceSeconds Int

  @@map("deployment_policies")
}

model Quote {
  id                String   @id
  invocationId      String   @unique
  buyerId           String
  // Database column retained as sessionId for the on-chain quote document;
  // application code always refers to this as a thread.
  threadId          String   @map("sessionId")
  appId             String
  commandRevisionId String?
  clientRequestId   String
  requestHash       String
  validUntil        DateTime
  document          Json
  createdAt         DateTime @default(now())

  thread          ChatThread          @relation(fields: [threadId], references: [id], onDelete: Restrict)
  app             App                 @relation(fields: [appId], references: [id], onDelete: Restrict)
  commandRevision AppCommandRevision? @relation(fields: [commandRevisionId], references: [id], onDelete: SetNull)
  invocation      Invocation?

  @@unique([buyerId, clientRequestId])
  @@index([threadId, validUntil])
  @@index([appId])
  @@map("quotes")
}
