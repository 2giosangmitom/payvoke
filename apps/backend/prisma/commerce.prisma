// Minimal persisted admissions for the quote/payment foundation. Catalog,
// workspace/context management and provider execution remain deferred.
// buyerId is Better Auth User.id, not provider Account.id. Auth models stay
// CLI-owned; authenticated admission checks ownership against the live User.
model Product {
  id            String @id @default(uuid())
  kind          String
  status        String @default("DRAFT")
  activeVersion Int?
  versions      ProductVersion[]
  sessions      UsageSession[]

  @@map("products")
}

model ProductVersion {
  productId     String
  number        Int
  status        String @default("DRAFT")
  payoutAddress String
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  commands      CommandVersion[]

  @@id([productId, number])
  @@map("product_versions")
}

model CommandVersion {
  id               String @id @default(uuid())
  commandId        String
  productId        String
  productVersion   Int
  inputSchema      Json
  grossAmount      Decimal @db.Decimal(78, 0)
  terms            Json
  deliverySeconds  Int
  reviewSeconds    Int
  version          ProductVersion @relation(fields: [productId, productVersion], references: [productId, number], onDelete: Restrict)

  @@unique([productId, productVersion, commandId])
  @@map("command_versions")
}

model UsageSession {
  id               String @id @default(uuid())
  buyerId          String
  productId        String
  archivedAt       DateTime?
  activeQuoteId    String? @unique
  quoteLockVersion Int @default(0)
  product          Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quotes           Quote[]

  @@index([buyerId])
  @@map("usage_sessions")
}

model DeploymentPolicy {
  version                String @id
  // Only the current policy has activeSlot="active"; old versions are retained.
  activeSlot             String? @unique
  vault                  String
  feeBps                 Int
  feeRecipient           String
  quoteLifetimeSeconds   Int
  maxHoldSeconds         Int
  resolutionGraceSeconds Int

  @@map("deployment_policies")
}

model Quote {
  id              String @id
  invocationId    String @unique
  buyerId         String
  sessionId       String
  clientRequestId String
  requestHash     String
  validUntil      DateTime
  document        Json
  createdAt       DateTime @default(now())
  session         UsageSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  invocation      Invocation?

  @@unique([buyerId, clientRequestId])
  @@index([sessionId, validUntil])
  @@map("quotes")
}
