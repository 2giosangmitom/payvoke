# Runtime DB: local Docker for development, Neon for production only.
# Tests default to PGlite and do not use DATABASE_URL. Never commit credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payvoke
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
HOST=127.0.0.1
PORT=3001
PROCESS_ROLE=api
LOG_LEVEL=info
CHAIN_ID=43113
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
PAYMENTS_ENABLED=false
# Only set after approving deployment and worker gas policy.
# FACILITATOR_URL=https://private-facilitator.example
# FACILITATOR_TOKEN=<separate service secret; never a relayer key>
# RPC_URL and VAULT_ADDRESS are optional until a deployment is available.
# Setting them does not enable payments. Worker keys do not belong in the API.
