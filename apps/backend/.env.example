# Supply a dedicated Neon database URL locally; never commit credentials.
DATABASE_URL=postgresql://user:password@your-neon-host/payvoke?sslmode=require
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3001
PROCESS_ROLE=api
LOG_LEVEL=info
CHAIN_ID=43113
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
PAYMENTS_ENABLED=false
# RPC_URL and VAULT_ADDRESS are optional until a deployment is available.
# Setting them does not enable payments. Worker keys do not belong in the API.
