# Ops executor role: pnpm ops:executor finance-tick
# Copy to private/executor.env. Sends applyDecision for an already approved decision.
# The CLI refuses to run if APPROVER_PRIVATE_KEY is also present.

RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CEREMONY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/payvoke_fuji_test
# Wallet holding FINANCE_EXECUTOR_ROLE; fund with Fuji AVAX. SECRET.
FINANCE_EXECUTOR_PRIVATE_KEY=
# Both must be true for finance-tick to send.
FUJI_BROADCAST_ENABLED=false
FINANCE_EXECUTION_ENABLED=false
