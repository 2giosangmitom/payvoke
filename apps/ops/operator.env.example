# Ops operator role: pnpm ops:operator <preflight|prepare|broadcast|receipt|seed|payment-check|journal-check>
# Copy to private/operator.env. Never put buyer, approver or executor keys here.

# Required. Fuji RPC with finalized block support. SECRET if it embeds a key.
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Deployer/admin key used by prepare (deploy, role grants). SECRET.
OPERATOR_PRIVATE_KEY=
# Dedicated loopback ceremony database, name must match payvoke_fuji_*.
CEREMONY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/payvoke_fuji_test
# true only for an approved broadcast.
FUJI_BROADCAST_ENABLED=false
