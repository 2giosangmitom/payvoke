# Ops buyer role: pnpm ops:buyer <login|payment-prepare|payment-submit|payment-poll>
# Copy to private/buyer.env. Talks to the API from run.json; no RPC needed.

# Buyer wallet used for SIWE login. SECRET.
BUYER_PRIVATE_KEY=
# Session signer registered on the buyer's vault grant. SECRET.
GRANT_PRIVATE_KEY=
# true only for an approved payment-submit.
FUJI_BROADCAST_ENABLED=false
