# Ops approver role: pnpm ops:approver finance-approve
# Copy to private/approver.env. Signs EIP-712 decisions only; never broadcasts.
# The CLI refuses to run if FINANCE_EXECUTOR_PRIVATE_KEY is also present.

RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Wallet holding RELEASE_APPROVER_ROLE / REFUND_APPROVER_ROLE. Must differ from the executor. SECRET.
APPROVER_PRIVATE_KEY=
