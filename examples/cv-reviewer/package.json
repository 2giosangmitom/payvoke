{
  "name": "cv-reviewer",
  "private": true,
  "description": "Payvoke CV reviews and improved, source-grounded PDF resumes.",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test test/",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target=bun --outdir dist"
  },
  "dependencies": {
    "@mastra/core": "^1.82.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "mammoth": "^1.11.0",
    "pdf-lib": "^1.17.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@types/bun": "^1.4.4",
    "jszip": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
