# Payvoke API (Bun loads .env automatically)
PAYVOKE_API=https://payvoke.up.railway.app
# The buyer wallet (Fuji). It needs test USDC only: the buyer pays no gas.
BUYER_PRIVATE_KEY=0x
# Optional: a buyer access token (pvb_…) from the console instead of SIWE.
# BUYER_PRIVATE_KEY is still needed to sign the payment.
PAYVOKE_ACCESS_TOKEN=
# Optional: the web origin the API trusts for SIWE, when it differs from PAYVOKE_API.
PAYVOKE_WEB_ORIGIN=
