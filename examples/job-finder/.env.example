# Payvoke app (Studio > your agent > API key)
PAYVOKE_API_URL=https://payvoke.up.railway.app
PAYVOKE_APP_ID=
PAYVOKE_KEY=pvk_

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
MODEL=openrouter/nvidia/nemotron-3.5-lightning:free
# Tried in order when MODEL is rate limited
FALLBACK_MODELS=openrouter/google/gemma-4-26b-a4b-it:free
# Retries per model before falling back
MODEL_RETRIES=2

# Prices in atomic USDC (6 decimals): 150000 = 0.15 USDC
PRICE_FIND_JOB=150000

# Where job state (tool calls, invocations) is kept between runs
STATE_DIR=.data
