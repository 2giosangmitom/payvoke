# Payvoke app (Studio > your agent > API key)
PAYVOKE_API_URL=https://payvoke.up.railway.app
PAYVOKE_APP_ID=
PAYVOKE_KEY=pvk_

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
MODEL=openrouter/nvidia/nemotron-3.5-lightning:free
# Tried in order when MODEL is rate limited
FALLBACK_MODELS=openrouter/google/gemma-4-26b-a4b-it:free
# Retries per model before falling back
MODEL_RETRIES=2

# Prices in atomic USDC (6 decimals): 150000 = 0.15 USDC
PRICE_FIND_JOB=150000

# Where job state (tool calls, invocations) is kept between runs
STATE_DIR=.data

# Agent hires agent (optional, off unless both are set). find_job first buys a
# CV Reviewer quick_review over x402 with Job Finder's own wallet (a buyer
# account: it signs in with SIWE and needs Fuji test USDC, no AVAX). If the
# review fails or times out, its escrow is refunded and find_job continues.
CV_REVIEWER_APP_ID=
JOB_FINDER_BUYER_KEY=
# Spend cap per review, atomic USDC (500000 = 0.50 USDC)
CV_REVIEWER_MAX_AMOUNT=500000
# Give up on the review after this long (find_job must deliver within 300 s)
CV_REVIEWER_TIMEOUT_MS=120000
# Web origin for SIWE, only if it differs from PAYVOKE_API_URL
# PAYVOKE_WEB_ORIGIN=
