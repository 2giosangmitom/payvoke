# Docker Compose settings for the production stack (compose.yml). Copy to .env
# next to compose.yml; Compose reads it for variable substitution only. Each
# service still needs its own apps/<service>/.env (see their .env.example).

# Public origins browsers use. API_ORIGIN is also baked into the web bundle,
# so rebuild `web` after changing it. WEB_ORIGIN gates CORS on the API and on
# object storage.
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
# Origin of object storage as browsers and providers reach it; presigned URLs
# point here.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# SECRET. Postgres password for the `payvoke` user.
POSTGRES_PASSWORD=
# SECRET. Object storage credentials (RustFS root user and the services' S3 key).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=payvoke-files

# Published ports. Keep BIND_ADDRESS on loopback behind a reverse proxy; use
# 0.0.0.0 only to expose them directly.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=3001
S3_PORT=9000

# Optional. Fuji RPC for the browser wallet; wagmi's default when empty.
FUJI_RPC_URL=
