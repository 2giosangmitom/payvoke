enum SettlementState {
  PENDING
  HELD
  REJECTED
  QUARANTINED
}

enum SettlementAttemptState {
  RESERVED
  SIGNED
  BROADCAST
  UNKNOWN
  CONFIRMED
  FINALIZED
  REVERTED
}

enum InvocationExecutionStatus {
  NOT_STARTED
  QUEUED
  ACKED
  RUNNING
  WAITING_BUYER
  VERIFYING
  DELIVERED
  FAILED
}

model Invocation {
  id              String @id
  quoteId         String @unique
  buyerId         String
  executionStatus InvocationExecutionStatus @default(NOT_STARTED)
  // Points at the run currently allowed to stream/report. A question answer or
  // in-scope revision starts a new run for the same invocation and hold.
  runId           String? @unique
  createdAt       DateTime @default(now())
  quote           Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  settlement      SettlementOperation?
  readyEvent      InvocationReady?
  streamEvents    AguiStreamEvent[]
  run             ProviderRun? @relation("ActiveRun", fields: [runId], references: [runId], onDelete: Restrict)
  runs            ProviderRun[] @relation("InvocationRuns")
  questions       InvocationQuestion[]
  answers         InvocationAnswer[]
  revisions       InvocationRevision[]

  @@index([buyerId, createdAt])
  @@map("invocations")
}

model SettlementOperation {
  invocationId        String @id
  invocationKey       String @unique
  quoteDigest         String
  authorizationDigest String
  recoveredSigner     String
  // Untrusted admission intent, not evidence of an onchain grant/hold.
  paymentPayload      Json
  state               SettlementState @default(PENDING)
  errorReason         String?
  leaseOwner          String?
  leaseEpoch          BigInt @default(0)
  leaseExpiresAt      DateTime?
  revision            BigInt @default(0)
  nextCheckAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  invocation          Invocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  attempt             SettlementAttempt?

  @@index([state, leaseExpiresAt, createdAt])
  @@map("settlement_operations")
}

model SettlementAttempt {
  id                   String @id @default(uuid())
  // MVP: no automatic replacement, fee bump or second attempt.
  invocationId         String @unique
  network              String
  relayer              String
  nonce                BigInt
  gasLimit             BigInt
  maxFeePerGas         Decimal @db.Decimal(78, 0)
  maxPriorityFeePerGas  Decimal @db.Decimal(78, 0)
  state                SettlementAttemptState @default(RESERVED)
  signedTransaction    String? @db.Text
  transactionHash      String? @unique
  broadcastAt          DateTime?
  broadcastCount       Int @default(0)
  lastErrorReason      String?
  receiptBlockNumber   BigInt?
  receiptBlockHash     String?
  finalizedBlockNumber BigInt?
  finalizedBlockHash   String?
  actualGasCost        Decimal? @db.Decimal(78, 0)
  finalizedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  operation            SettlementOperation @relation(fields: [invocationId], references: [invocationId], onDelete: Restrict)
  lane                 RelayerLane @relation(fields: [network, relayer], references: [network, relayer], onDelete: Restrict)

  @@unique([network, relayer, nonce])
  @@index([network, relayer, finalizedAt])
  @@map("settlement_attempts")
}

model RelayerLane {
  network            String
  relayer            String
  // This reservation NEVER expires with a worker lease. An ambiguous tx keeps
  // its lane until a future finality/recovery gate safely resolves it.
  activeInvocationId String? @unique
  revision           BigInt @default(0)
  attempts           SettlementAttempt[]

  @@id([network, relayer])
  @@map("relayer_lanes")
}

// Durable handoff only. Provider delivery/ACK belongs to a later milestone.
model InvocationReady {
  invocationId String @id
  quoteId      String
  createdAt    DateTime @default(now())
  acknowledgedAt DateTime?
  runId        String @default(uuid())
  invocation   Invocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)

  @@map("invocation_ready")
}

model ProviderRun {
  runId           String @id @default(uuid())
  invocationId    String
  sequence        Int @default(0)
  reportSequence  Int @default(0)
  activeMessageId String?
  state           String @default("QUEUED")
  result          Json?
  acknowledgedAt  DateTime?
  updatedAt       DateTime @updatedAt
  invocation      Invocation @relation("InvocationRuns", fields: [invocationId], references: [id], onDelete: Restrict)
  activeFor       Invocation? @relation("ActiveRun")
  surfaces        OpenUISurface[]
  reports         ProviderReport[]

  @@index([invocationId, updatedAt])
  @@map("provider_runs")
}

model ProviderReport {
  runId String
  sequence Int
  reportId String
  contentHash String
  type String
  run ProviderRun @relation(fields: [runId], references: [runId], onDelete: Restrict)

  @@id([runId, sequence])
  @@unique([runId, reportId])
  @@map("provider_reports")
}

model AguiStreamEvent {
  cursor BigInt @id @default(autoincrement())
  invocationId String
  threadId String
  runId String
  streamSequence Int?
  sourceHash String?
  event Json
  createdAt DateTime @default(now())
  invocation Invocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)

  @@unique([runId, streamSequence])
  @@index([threadId, cursor])
  @@map("agui_stream_events")
}

// Accumulated OpenUI Lang program for one provider surface. Patches append
// complete statements; the gateway re-validates the whole program each time.
model OpenUISurface {
  runId String
  surfaceId String
  source String
  updatedAt DateTime @updatedAt
  run ProviderRun @relation(fields: [runId], references: [runId], onDelete: Restrict)

  @@id([runId, surfaceId])
  @@map("openui_surfaces")
}

// A provider question closes the current run with RUN_FINISHED but keeps the
// invocation (and its hold) alive. Only a buyer answer starts the next run.
model InvocationQuestion {
  id                String   @id @default(uuid())
  invocationId      String
  questionId        String
  runId             String
  prompt            String
  inputSchema       Json
  chatTextParameter String?
  status            String   @default("OPEN")
  createdAt         DateTime @default(now())
  answeredAt        DateTime?
  invocation        Invocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  answer            InvocationAnswer?

  @@unique([invocationId, questionId])
  @@index([invocationId, status])
  @@map("invocation_questions")
}

model InvocationAnswer {
  id              String   @id @default(uuid())
  invocationId    String
  questionId      String
  runId           String
  buyerId         String
  clientRequestId String   @db.VarChar(128)
  arguments       Json
  acknowledgedAt  DateTime?
  createdAt       DateTime @default(now())
  invocation      Invocation         @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  question        InvocationQuestion @relation(fields: [invocationId, questionId], references: [invocationId, questionId], onDelete: Restrict)

  @@unique([invocationId, clientRequestId])
  @@unique([invocationId, questionId])
  @@index([buyerId, createdAt])
  @@map("invocation_answers")
}

// In-scope revisions reuse the invocation/hold. A revision may only target a
// delivered artifact and the next result must publish a higher artifactVersion.
model InvocationRevision {
  id                   String   @id @default(uuid())
  invocationId         String
  runId                String
  buyerId              String
  clientRequestId      String   @db.VarChar(128)
  reason               String   @db.Text
  targetArtifactVersion Int?
  status               String   @default("REQUESTED")
  acknowledgedAt       DateTime?
  createdAt            DateTime @default(now())
  invocation           Invocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)

  @@unique([invocationId, clientRequestId])
  @@index([buyerId, createdAt])
  @@map("invocation_revisions")
}

model SettlementScanCursor {
  id          String @id
  blockNumber BigInt
  blockHash   String
  updatedAt   DateTime @updatedAt

  @@map("settlement_scan_cursors")
}

model SettlementIncident {
  id              String @id
  transactionHash String
  invocationKey   String
  reason          String
  createdAt       DateTime @default(now())

  @@map("settlement_incidents")
}

// Chain projections are evidence, never an independent spendable balance.
model VaultFinancialHealth {
  id String @id
  blocked Boolean @default(false)
  reason String?
  updatedAt DateTime @updatedAt
  @@map("vault_financial_health")
}

model VaultHoldProjection {
  holdId String @id
  vault String
  invocationId String? @unique
  status String
  snapshot Json
  version BigInt
  blockNumber BigInt
  blockHash String
  updatedAt DateTime @updatedAt
  @@index([vault, blockNumber])
  @@map("vault_hold_projections")
}

model VaultFinancialEvent {
  id String @id
  vault String
  name String
  holdId String?
  transactionHash String
  blockNumber BigInt
  blockHash String
  logIndex Int
  data Json
  @@index([holdId, blockNumber])
  @@map("vault_financial_events")
}

// Created only by the trusted output verifier/operator, never a provider report.
model PaymentDeliveryEvidence {
  id String @id
  invocationId String
  artifactVersion Int
  outputHash String
  verifier String
  observedAt DateTime
  accessInterruptionSeconds Int
  // SIGN/REC/WIT evidence class and its JCS envelope.
  evidenceLevel String
  envelope Json
  envelopeHash String
  createdAt DateTime @default(now())
  @@index([invocationId, observedAt])
  @@map("payment_delivery_evidence")
}

enum FinanceDecisionState {
  APPROVED
  REJECTED
  RESERVED
  SIGNED
  BROADCAST
  UNKNOWN
  FINALIZED
  REVERTED
  QUARANTINED
}

model FinanceDecision {
  id String @id
  holdId String
  vault String
  digest String @unique
  decision Json
  beforeHold Json?
  approver String
  signature String
  evidenceId String?
  reason String
  state FinanceDecisionState @default(APPROVED)
  executor String?
  nonce BigInt?
  gasLimit BigInt?
  maxFeePerGas Decimal? @db.Decimal(78, 0)
  maxPriorityFeePerGas Decimal? @db.Decimal(78, 0)
  signedTransaction String? @db.Text
  transactionHash String? @unique
  broadcastCount Int @default(0)
  actualGasCost Decimal? @db.Decimal(78, 0)
  receipt Json?
  finalizedAt DateTime?
  errorReason String?
  leaseOwner String?
  leaseEpoch BigInt @default(0)
  leaseExpiresAt DateTime?
  nextCheckAt DateTime @default(now())
  revision BigInt @default(0)
  createdAt DateTime @default(now())
  @@unique([executor, nonce])
  @@index([state, nextCheckAt])
  @@index([executor, finalizedAt])
  @@map("finance_decisions")
}

model FinanceLane {
  id String @id
  activeDecisionId String? @unique
  revision BigInt @default(0)
  @@map("finance_lanes")
}
