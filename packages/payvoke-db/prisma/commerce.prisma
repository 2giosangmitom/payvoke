// Active marketplace model: an app is a provider-owned bot with slash commands
// registered through the API, used from one chat thread. Every message or
// command is a free interaction for the bot, which answers with a message, a
// form or a priced offer; only an accepted offer becomes a payable quote.
// App status is ACTIVE | SUSPENDED | ARCHIVED. Visibility is PUBLIC | PRIVATE.
// Availability is derived from lastHeartbeatAt, never stored as a mutable field.

model App {
  id               String    @id @default(uuid())
  ownerId          String
  clientRequestId  String
  name             String
  description      String?
  visibility       String    @default("PUBLIC")
  status           String    @default("ACTIVE")
  payoutAddress    String
  defaultCommandId String?   @unique
  lastHeartbeatAt  DateTime?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apiKeys        AppApiKey[]
  commands       AppCommand[]
  defaultCommand AppCommand?  @relation("AppDefaultCommand", fields: [defaultCommandId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  threads        ChatThread[]
  stars          AppStar[]
  quotes         Quote[]
  files          FileAsset[]
  offers         Offer[]

  @@unique([ownerId, clientRequestId])
  @@index([visibility, status, id])
  @@index([ownerId, createdAt])
  @@map("apps")
}

model AppApiKey {
  id         String    @id @default(uuid())
  appId      String
  prefix     String    @unique
  secretHash String    @unique
  scopes     String[]
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  app        App       @relation(fields: [appId], references: [id], onDelete: Restrict)

  @@index([appId, revokedAt])
  // An app has at most one unrevoked key.
  @@unique([appId], where: raw("\"revokedAt\" IS NULL"), map: "app_api_keys_one_active_per_app")
  @@map("app_api_keys")
}

model AppCommand {
  id               String    @id @default(uuid())
  appId            String
  name             String
  description      String
  activeRevisionId String?   @unique
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  app             App                  @relation(fields: [appId], references: [id], onDelete: Cascade)
  activeRevision  AppCommandRevision?  @relation("CommandActiveRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  revisions       AppCommandRevision[] @relation("CommandRevisions")
  defaultForApps  App[]                @relation("AppDefaultCommand")

  @@unique([appId, name])
  @@index([appId, archivedAt])
  @@map("app_commands")
}

// Every edit appends a revision. Quotes pin the revision they were issued for,
// so changing a command never rewrites an existing quote or invocation.
model AppCommandRevision {
  id                  String   @id @default(uuid())
  commandId           String
  options             Json
  inputSchema         Json
  outputSchema        Json?
  positionalParameter String?
  // Prices always come from the bot's offer; this optional cap bounds them.
  maxGrossAmount      Decimal? @db.Decimal(78, 0)
  terms               Json
  deliverySeconds     Int
  reviewSeconds       Int
  createdAt           DateTime @default(now())

  command   AppCommand  @relation("CommandRevisions", fields: [commandId], references: [id], onDelete: Cascade)
  activeFor AppCommand? @relation("CommandActiveRevision")
  quotes    Quote[]
  offers    Offer[]

  @@index([commandId, createdAt])
  @@map("app_command_revisions")
}

model ChatThread {
  id               String    @id @default(uuid())
  buyerId          String
  appId            String
  title            String?
  clientRequestId  String    @default(uuid())
  activeQuoteId    String?   @unique
  quoteLockVersion Int       @default(0)
  lastMessageAt    DateTime  @default(now())
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  app      App             @relation(fields: [appId], references: [id], onDelete: Restrict)
  quotes   Quote[]
  files    FileAsset[]
  messages ThreadMessage[]
  offers   Offer[]

  @@unique([buyerId, clientRequestId])
  @@index([buyerId, archivedAt, updatedAt])
  @@index([appId])
  @@map("chat_threads")
}

model AppStar {
  userId    String
  appId     String
  createdAt DateTime @default(now())
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([userId, appId])
  @@index([userId, createdAt])
  @@map("app_stars")
}

model DeploymentPolicy {
  version                String @id
  // Only the current policy has activeSlot="active"; old versions are retained.
  activeSlot             String? @unique
  vault                  String
  feeBps                 Int
  feeRecipient           String
  quoteLifetimeSeconds   Int
  maxHoldSeconds         Int
  resolutionGraceSeconds Int
  // Smallest gross price, in atomic USDC, that covers sponsored hold + release gas.
  minGrossAmount         Decimal @db.Decimal(78, 0)

  @@map("deployment_policies")
}

model Quote {
  id                String   @id
  invocationId      String   @unique
  buyerId           String
  // Database column retained as sessionId for the on-chain quote document;
  // application code always refers to this as a thread.
  threadId          String   @map("sessionId")
  appId             String
  commandRevisionId String?
  clientRequestId   String
  requestHash       String
  validUntil        DateTime
  document          Json
  createdAt         DateTime @default(now())

  thread          ChatThread          @relation(fields: [threadId], references: [id], onDelete: Restrict)
  app             App                 @relation(fields: [appId], references: [id], onDelete: Restrict)
  commandRevision AppCommandRevision? @relation(fields: [commandRevisionId], references: [id], onDelete: SetNull)
  invocation      Invocation?
  offer           Offer?

  @@unique([buyerId, clientRequestId])
  @@index([threadId, validUntil])
  @@index([appId])
  @@map("quotes")
}

// Free pre-sale conversation of an AGENT thread. Nothing here is paid; the
// provider sees content (and file manifests, never file bytes) before a hold.
model ThreadMessage {
  id              String    @id @default(uuid())
  threadId        String
  seq             Int
  role            String
  content         String
  commandId       String?
  arguments       Json?
  fileManifest    Json?
  // A provider message may carry a form ({title, description?, schema}); the
  // buyer's single answer to it points back through replyToId.
  form            Json?
  replyToId       String?   @unique
  clientRequestId String
  // Provider acknowledgement of the thread.message event (buyer messages only).
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())

  thread  ChatThread     @relation(fields: [threadId], references: [id], onDelete: Restrict)
  replyTo ThreadMessage? @relation("FormReply", fields: [replyToId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reply   ThreadMessage? @relation("FormReply")

  @@unique([threadId, seq])
  @@unique([threadId, role, clientRequestId])
  @@index([threadId, role, acknowledgedAt])
  @@map("thread_messages")
}

// A provider's priced proposal. Immutable once created; status is
// OPEN | ACCEPTED | DECLINED | WITHDRAWN | SUPERSEDED. Expiry is read from
// expiresAt. Accepting turns it into exactly one Quote.
model Offer {
  id                String   @id @default(uuid())
  threadId          String
  appId             String
  commandRevisionId String
  arguments         Json
  grossAmount       Decimal  @db.Decimal(78, 0)
  deliverySeconds   Int
  summary           String
  // Hash of the conversation up to and including messageSeq.
  messageSeq        Int
  conversationHash  String
  status            String   @default("OPEN")
  expiresAt         DateTime
  quoteId           String?  @unique
  clientRequestId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  thread          ChatThread         @relation(fields: [threadId], references: [id], onDelete: Restrict)
  app             App                @relation(fields: [appId], references: [id], onDelete: Restrict)
  commandRevision AppCommandRevision @relation(fields: [commandRevisionId], references: [id], onDelete: Restrict)
  quote           Quote?             @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@unique([appId, clientRequestId])
  @@index([threadId, createdAt])
  // A thread has at most one open offer.
  @@unique([threadId], where: raw("\"status\" = 'OPEN'"), map: "offers_one_open_per_thread")
  @@map("offers")
}
