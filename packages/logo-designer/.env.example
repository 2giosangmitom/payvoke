# Separate integration token; never use a buyer's Supabase token.
PROVIDER_TOKEN=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
PORT=8200
HOST=127.0.0.1
PROVIDER_DATABASE=data/logo-designs.sqlite
# Outbound Gateway integration (separate from the legacy inbound PROVIDER_TOKEN).
AGENTNE_URL=http://localhost:8000
AGENTNE_APPLICATION_ID=
AGENTNE_API_KEY=
AGENTNE_COMMAND_REVISION=
AGENTNE_JOURNAL=data/gateway.sqlite
REGISTER_COMMANDS=false
ALLOW_MODEL_EXPENSE=false
